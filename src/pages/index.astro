---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Chalkwell Park Rooms | Premier Event Venue in Southend">
  <!-- Hero Section -->
  <header class="hero">
    <div class="hero__left">
      <div class="hero__content">
        <span class="hero__badge">Est. in Southend-on-Sea</span>
        <h1 class="hero__title">
          Host Your
          <span class="hero__title-accent">Private Party</span>
          at Chalkwell Park Rooms
        </h1>
        <p class="hero__subtitle">The perfect location for your party or event</p>
        <div class="hero__cta">
          <a href="/booking" class="btn btn--gold btn--large">Make a Booking</a>
          <a href="#about" class="btn btn--secondary btn--large">Discover More</a>
        </div>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__pattern"></div>
      <div class="hero__decorative">
        <div class="hero__frame">
          <div class="hero__frame-corner hero__frame-corner--tl"></div>
          <div class="hero__frame-corner hero__frame-corner--tr"></div>
          <div class="hero__frame-corner hero__frame-corner--bl"></div>
          <div class="hero__frame-corner hero__frame-corner--br"></div>
          <div class="hero__frame-inner">
            <div class="hero__frame-icon">&#10022;</div>
            <span class="hero__frame-text">Creating Memories<br/>Since Day One</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__scroll">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </header>

  <!-- Wedding Feature Section -->
  <section class="wedding-feature">
    <div class="container">
      <div class="wedding-feature__grid">
        <div class="wedding-feature__content">
          <span class="section-tag">Celebrations</span>
          <h2 class="wedding-feature__title">Weddings at<br/>Chalkwell Park Rooms</h2>
          <div class="wedding-feature__divider">
            <span class="wedding-feature__divider-line"></span>
            <span class="wedding-feature__divider-icon">&#10087;</span>
            <span class="wedding-feature__divider-line"></span>
          </div>
          <p class="wedding-feature__tagline">One of the best wedding venues in Southend</p>
          <a href="/weddings" class="btn btn--primary">Explore Weddings</a>
        </div>

        <div class="wedding-feature__visual">
          <div class="wedding-feature__card">
            <div class="wedding-feature__card-content">
              <div class="wedding-feature__rings">
                <div class="wedding-feature__ring"></div>
                <div class="wedding-feature__ring"></div>
              </div>
              <span class="wedding-feature__card-text">Your Dream Day Awaits</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about">
    <div class="container">
      <div class="about__header">
        <span class="section-tag">Our Venue</span>
        <h2 class="about__title">Overlooking the Beautiful<br/>Chalkwell Park</h2>
      </div>

      <div class="about__grid">
        <div class="about__text">
          <p class="about__lead">
            Our venue occupies stunning grounds overlooking Chalkwell Park, providing the perfect backdrop for your most memorable occasions.
          </p>
          <p class="about__body">
            From elegant three-course dinners for 100 guests to intimate business gatherings, we accommodate weddings, parties, corporate conferences, and special events with impeccable attention to detail.
          </p>
        </div>

        <div class="about__stats">
          <div class="about__stat">
            <span class="about__stat-number">100+</span>
            <span class="about__stat-label">Guest Capacity</span>
          </div>
          <div class="about__stat">
            <span class="about__stat-number">24hr</span>
            <span class="about__stat-label">Response Time</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="services">
    <div class="container">
      <div class="services__header">
        <span class="section-tag section-tag--light">What We Offer</span>
        <h2 class="services__title">Exceptional Experiences<br/>for Every Occasion</h2>
      </div>

      <div class="services__grid">
        <article class="service-card">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <h3 class="service-card__title">Wedding Celebrations</h3>
          <p class="service-card__desc">Create unforgettable memories with our bespoke wedding packages and attentive service.</p>
          <a href="/weddings" class="service-card__link">Learn More &rarr;</a>
        </article>

        <article class="service-card">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="service-card__title">Clubs & Associations</h3>
          <p class="service-card__desc">Regular venue partnerships for networking groups and professional associations.</p>
          <a href="/booking" class="service-card__link">Enquire Now &rarr;</a>
        </article>

        <article class="service-card">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
              <line x1="9" y1="9" x2="9.01" y2="9"/>
              <line x1="15" y1="9" x2="15.01" y2="9"/>
            </svg>
          </div>
          <h3 class="service-card__title">Comedy Nights</h3>
          <p class="service-card__desc">Join us at the Joker Comedy Club for evenings filled with laughter and entertainment.</p>
          <a href="#" class="service-card__link">View Events &rarr;</a>
        </article>

        <article class="service-card">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <h3 class="service-card__title">Family Celebrations</h3>
          <p class="service-card__desc">Birthdays, anniversaries, and family gatherings in an elegant setting.</p>
          <a href="/booking" class="service-card__link">Book Now &rarr;</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="cta">
    <div class="container">
      <div class="cta__content">
        <span class="section-tag">Get in Touch</span>
        <h2 class="cta__title">Ready to Plan Your Event?</h2>
        <p class="cta__text">Get in touch with us today and let's make your vision a reality.</p>

        <div class="cta__phone">
          <a href="tel:01702555154" class="cta__phone-link">
            <span class="cta__phone-icon">&#9742;</span>
            <span>01702 555154</span>
          </a>
          <span class="cta__response">We respond within 24 hours</span>
        </div>

        <a href="/booking" class="btn btn--primary btn--large">Make a Booking</a>
      </div>
    </div>
  </section>
</Layout>
